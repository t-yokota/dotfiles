# Machine-local Git config included by .gitconfig
.gitconfig.local

# Claude Code runtime and installer state
.claude/ecc/
.claude/projects/
.claude/session*
.claude/history.jsonl
.claude/logs/
.claude/backups/
.claude/cache/
.claude/caches/
.claude/tmp/
.claude/statsig/
.claude/todos/
.claude/plugins/
.claude/plugin-cache/
.claude/.credentials.json
.claude/credentials.json
.claude/config.json
.claude/models_cache.json
.claude/session_index.jsonl
.claude/*.log
.claude/*.db
.claude/*.sqlite
.claude/*.sqlite-wal
.claude/*.sqlite-shm

# Claude embedded agent runtime/cache state
.claude/.agents/logs/
.claude/.agents/backups/
.claude/.agents/cache/
.claude/.agents/caches/
.claude/.agents/tmp/
.claude/.agents/plugin-cache/
.claude/.agents/sessions/
.claude/.agents/.credentials.json
.claude/.agents/credentials.json
.claude/.agents/config.json
.claude/.agents/models_cache.json
.claude/.agents/session_index.jsonl
.claude/.agents/*.log
.claude/.agents/*.db
.claude/.agents/*.sqlite
.claude/.agents/*.sqlite-wal
.claude/.agents/*.sqlite-shm

# Claude collection-local runtime/cache state
.claude/rules/logs/
.claude/rules/backups/
.claude/rules/cache/
.claude/rules/caches/
.claude/rules/tmp/
.claude/rules/*.log
.claude/rules/*.db
.claude/rules/*.sqlite
.claude/rules/*.sqlite-wal
.claude/rules/*.sqlite-shm
.claude/skills/logs/
.claude/skills/backups/
.claude/skills/cache/
.claude/skills/caches/
.claude/skills/tmp/
.claude/skills/*.log
.claude/skills/*.db
.claude/skills/*.sqlite
.claude/skills/*.sqlite-wal
.claude/skills/*.sqlite-shm

# Codex runtime, credential, backup, and generated hook state
.codex/ecc-install-state.json
.codex/dotfiles-*-sync-state.json
.codex/backups/
.codex/git-hooks/
.codex/auth.json
.codex/sessions/
.codex/logs/
.codex/cache/
.codex/caches/
.codex/tmp/
.codex/plugins/
.codex/plugin-cache/
.codex/.credentials.json
.codex/credentials.json
.codex/config.json
.codex/models_cache.json
.codex/session_index.jsonl
.codex/history.jsonl
.codex/*.log
.codex/*.db
.codex/*.sqlite
.codex/*.sqlite-wal
.codex/*.sqlite-shm

# User-level agent runtime/cache state
.agents/logs/
.agents/backups/
.agents/cache/
.agents/caches/
.agents/tmp/
.agents/plugins/
.agents/plugin-cache/
.agents/sessions/
.agents/.credentials.json
.agents/credentials.json
.agents/config.json
.agents/models_cache.json
.agents/session_index.jsonl
.agents/*.log
.agents/*.db
.agents/*.sqlite
.agents/*.sqlite-wal
.agents/*.sqlite-shm
