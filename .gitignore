# Machine-local Git config included by .gitconfig
.gitconfig.local

# Claude Code runtime, cache, and credential state
.claude/projects/
.claude/session*
.claude/history.jsonl
.claude/logs/
.claude/cache/
.claude/caches/
.claude/tmp/
.claude/statsig/
.claude/todos/
.claude/plugins/
.claude/plugin-cache/
.claude/.credentials.json
.claude/credentials.json
.claude/config.json
.claude/models_cache.json
.claude/session_index.jsonl
.claude/*.log
.claude/*.db
.claude/*.sqlite
.claude/*.sqlite-wal
.claude/*.sqlite-shm

# Codex runtime, cache, and credential state
.codex/auth.json
.codex/sessions/
.codex/logs/
.codex/cache/
.codex/caches/
.codex/tmp/
.codex/plugins/
.codex/plugin-cache/
.codex/.credentials.json
.codex/credentials.json
.codex/config.json
.codex/models_cache.json
.codex/session_index.jsonl
.codex/history.jsonl
.codex/*.log
.codex/*.db
.codex/*.sqlite
.codex/*.sqlite-wal
.codex/*.sqlite-shm

# User-level agent runtime, cache, and credential state
.agents/logs/
.agents/backups/
.agents/cache/
.agents/caches/
.agents/tmp/
.agents/plugins/
.agents/plugin-cache/
.agents/sessions/
.agents/.credentials.json
.agents/credentials.json
.agents/config.json
.agents/models_cache.json
.agents/session_index.jsonl
.agents/*.log
.agents/*.db
.agents/*.sqlite
.agents/*.sqlite-wal
.agents/*.sqlite-shm
