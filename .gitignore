# Machine-local Git config included by .gitconfig
.gitconfig.local

# Claude Code runtime and installer state
.claude/ecc/
.claude/projects/
.claude/session*
.claude/history.jsonl
.claude/logs/
.claude/cache/
.claude/caches/
.claude/tmp/
.claude/statsig/
.claude/todos/
.claude/plugins/
.claude/plugin-cache/
.claude/.credentials.json
.claude/credentials.json
.claude/config.json
.claude/models_cache.json
.claude/session_index.jsonl
.claude/*.log
.claude/*.db
.claude/*.sqlite
.claude/*.sqlite-wal
.claude/*.sqlite-shm

# Codex runtime, credential, backup, and generated hook state
.codex/ecc-install-state.json
.codex/dotfiles-*-sync-state.json
.codex/backups/
.codex/git-hooks/
.codex/auth.json
.codex/sessions/
.codex/logs/
.codex/cache/
.codex/caches/
.codex/tmp/
.codex/plugins/
.codex/plugin-cache/
.codex/.credentials.json
.codex/credentials.json
.codex/config.json
.codex/models_cache.json
.codex/session_index.jsonl
.codex/history.jsonl
.codex/*.log
.codex/*.db
.codex/*.sqlite
.codex/*.sqlite-wal
.codex/*.sqlite-shm
